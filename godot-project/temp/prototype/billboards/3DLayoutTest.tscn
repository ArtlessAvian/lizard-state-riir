[sub_resource type="GDScript" id="GDScript_ni4nt"]
script/source = "@tool
extends Sprite3D

func _process(_delta: float) -> void:
	var cam_dir = EditorInterface.get_editor_viewport_3d().get_camera_3d().global_basis.z;
	#var cam_dir = get_viewport().get_camera_3d().basis.z;
	
	var cam_dir_drop_y = cam_dir * Vector3(1, 0, 1);
	
	var unsigned_angle = cam_dir_drop_y.angle_to(self.global_basis.z);
	if unsigned_angle < PI/4:
		self.frame = 0
	elif unsigned_angle > 3 * PI / 4:
		self.frame = 8
	else:
		self.flip_h = cam_dir_drop_y.dot(self.global_basis.x) > 0
		self.frame = 4
"

